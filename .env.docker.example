IRIS_IMAGE=intersystems/iris-community:2026.1
IRIS_PASSWORD=CHANGE_ME
# Puerto asignado a ppto-ventas en la tabla de HTC21-ARQUITECTURA.md §3.
# No cambiar salvo que se actualice esa tabla: noshow usa 52773/1972 y
# manten usa 52775/1974, todos en 127.0.0.1, para evitar colisión al levantar
# los tres a la vez. El superserver (1973 reservado) no se publica hoy: no
# hay razón para empezar.
IRIS_WEB_PORT=52774
# container_name (ppto-ventas-iris) es fijo en docker-compose.yml, no
# configurable por variable de entorno.
# WORKSPACE_DIR: no definir una ruta absoluta de máquina.
# docker-compose.yml ya usa ${WORKSPACE_DIR:-.}, que resuelve al directorio del
# proyecto. Dejarla sin definir salvo que el compose se ejecute desde otro lugar.
